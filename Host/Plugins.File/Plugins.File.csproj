<Project Sdk="Microsoft.NET.Sdk">

  <Target Name="CopyPluginToHost" AfterTargets="Build">
		<MakeDir Directories="$(SolutionDir)Host\bin\$(Configuration)\net10.0-windows\Plugins" />

		<Copy
			SourceFiles="$(TargetPath)"
			DestinationFolder="$(SolutionDir)Host\bin\$(Configuration)\net10.0-windows\Plugins"
			SkipUnchangedFiles="true" />
  </Target>
	
	
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts\Contracts.csproj" />
  </ItemGroup>

</Project>
